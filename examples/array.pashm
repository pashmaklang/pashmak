# We have an array of names. Print them one by one.

# Declare the `$names` array.
$names = ['parsa', 'pashmak', 'something']

# Set a counter for the loop.
$i = 0

while $i < len($names)
    println($names[$i])
    $i = $i + 1
endwhile
